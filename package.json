{
  "name": "pihole-browser-extension",
  "displayName": "PiHole Browser Extension",
  "version": "5.0.2",
  "private": true,
  "type": "module",
  "description": "Control your Pi-hole v6 from the toolbar: pause blocking, allow or deny the current site, several Pi-holes at once.",
  "author": "Pascal Glaser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badsgahhl/pihole-browser-extension.git"
  },
  "bugs": {
    "url": "https://github.com/badsgahhl/pihole-browser-extension/issues"
  },
  "homepage": "https://github.com/badsgahhl/pihole-browser-extension#readme",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare && simple-git-hooks",
    "generate:api": "node scripts/generate-api.ts",
    "lint:check": "oxlint . --deny-warnings && eslint . --max-warnings 0 --no-warn-ignored",
    "lint:fix": "oxlint . --fix && eslint . --fix --no-warn-ignored",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pre-commit": "pnpm type-check && pnpm lint-staged"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.55.0",
    "@vueuse/core": "^15.0.0",
    "@webext-core/messaging": "^4.0.0",
    "@wxt-dev/i18n": "^0.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@redocly/cli": "^2.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.vue": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "eslint --fix --no-warn-ignored",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,mjs,cjs,ts,mts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,md,yaml,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm pre-commit"
  }
}
