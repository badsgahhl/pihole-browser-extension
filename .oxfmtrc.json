{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "none",
  "sortTailwindcss": {},
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/.output/**",
    "**/.wxt/**",
    "**/coverage/**",
    "**/design/**",
    "**/api-spec/**",
    "**/src/lib/api/pihole/**",
    "**/src/components/ui/**",
    "**/src/public/**",
    "pnpm-lock.yaml"
  ]
}
